<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= recipe.dishName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="container mt-4">
    <h1><%= recipe.dishName %></h1>
    <p><strong>By:</strong> <%= recipe.user ? recipe.user.fullName : 'Unknown' %></p>
    <p><strong>Ingredients:</strong> <%= recipe.ingredients %></p>
    <p><strong>Cooking Time:</strong> <%= recipe.cookingTime %> minutes</p>
    <p><strong>Difficulty:</strong> <%= recipe.difficulty %></p>
    <p><strong>Instructions:</strong></p>
    <p><%= recipe.instructions %></p>
    <a href="/recipes" class="btn btn-secondary">Back to Recipes</a>
    <% if (currentUser && recipe.user && currentUser._id === recipe.user._id) { %>
      <a href="/recipes/<%= recipe._id %>/edit" class="btn btn-warning">Edit</a>
      <form action="/recipes/<%= recipe._id %>" method="POST" class="d-inline">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
      </form>
    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>